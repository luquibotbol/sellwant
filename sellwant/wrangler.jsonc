{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sellwant",
  "compatibility_date": "2026-08-17",
  "main": "worker/index.js",
  "account_id": "685b7b712d0c880fafade0c43ea84586",

  // custom_domain makes Cloudflare create and manage the DNS record itself.
  // Verify the record actually exists after a deploy: an OAuth login without
  // DNS scope reports the domain attached and silently creates nothing.
  "routes": [
    { "pattern": "sellwant.com", "custom_domain": true },
    // www exists only to redirect to the apex; the Worker does that in code.
    { "pattern": "www.sellwant.com", "custom_domain": true }
  ],

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",

    // "none" means: no asset matched -> run the Worker. The Worker is what
    // rewrites /deal/9f2c onto dist/deal/[id].html. Setting this to
    // "single-page-application" instead would return index.html with a 200 for
    // genuinely missing URLs, so typos would render the sign-in screen rather
    // than a 404.
    "not_found_handling": "none",

    // Expo emits /feed.html and links to /feed. Without dropping the slash,
    // Cloudflare 308-redirects to /feed/ and the relative asset paths break.
    "html_handling": "drop-trailing-slash",

    // Required for the www -> apex redirect to be reachable at all: without
    // it the platform serves a matching asset before the Worker ever runs, so
    // www.sellwant.com/ would render the app instead of redirecting. The
    // Worker now fetches assets itself, first thing, so behaviour is unchanged
    // for every path that maps to a real file.
    "run_worker_first": true
  },

  // Drains the email outbox (20260821_email_outbox.sql). Every minute is the
  // floor Cloudflare allows and an idle run costs nothing -- the batching that
  // stops eight offers becoming eight emails is a five-minute delay on the row
  // itself, not a slow cron.
  "triggers": {
    "crons": ["* * * * *"]
  },

  // Not secrets. The first two are inlined into the client bundle by
  // `expo export` and are readable by anyone who opens devtools -- RLS is what
  // protects the data. The Worker uses them to read active listings for link
  // previews, so a scraper is told nothing a logged-out visitor could not see.
  //
  // MAIL_FROM is the address notifications come FROM, and its domain must be
  // verified in Resend. A subdomain on purpose: one SPF record is allowed per
  // name, and the apex is where Supabase's auth mail already goes out.
  //
  // The three genuine secrets are set with `wrangler secret put` and are NOT
  // in this file:
  //   SUPABASE_SECRET_KEY  bypasses RLS -- only ever used for the outbox RPCs
  //   RESEND_API_KEY       sending
  //   UNSUB_SECRET         signs unsubscribe links; any 32+ random bytes
  "vars": {
    "SUPABASE_URL": "https://gguzeafbwsqkhggmcjjl.supabase.co",
    "SUPABASE_ANON_KEY": "sb_publishable_yURvtobGL9P0gJn0Ouwh3w__I1Xr2C4",
    "MAIL_FROM": "SellWant <offers@notify.sellwant.com>"
  },

  "observability": {
    "enabled": true
  }
}
