# SellWant — copy to .env and fill in.
#
# EXPO_PUBLIC_* is inlined into the shipped JS bundle by `expo export`, so
# anything with that prefix is PUBLIC the moment the site is live. The anon key
# is designed for that -- RLS is what actually protects the data. NEVER give
# the service role key an EXPO_PUBLIC_ prefix; it bypasses RLS entirely.

EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Password for the two seed accounts (maya@ and deshawn@example.edu) that
# tests/advance-deal.test.ts signs in as. No EXPO_PUBLIC_ prefix on purpose --
# it must never reach the client bundle, and it is not in git.
#
# To rotate it, set a new value here and run, in the Supabase SQL editor:
#
#   update auth.users
#   set encrypted_password = extensions.crypt('<new>', extensions.gen_salt('bf'))
#   where email in ('maya@example.edu', 'deshawn@example.edu');
#
SELLWANT_TEST_PASSWORD=
